        <?= /* @noEscape */ $block->getElementHtml() ?>
        <a href="#" class="rule-chooser-trigger">
            <img src="<?= $escaper->escapeUrl($block->getViewFileUrl('images/rule_chooser_trigger.gif')) ?>"
