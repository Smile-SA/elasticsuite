                 title="<?= $escaper->escapeHtmlAttr(__('Open Chooser')) ?>"/>
        </a>
        <a href="#" class="rule-param-apply">
            <img src="<?= $escaper->escapeUrl($block->getViewFileUrl('images/rule_component_apply.gif')) ?>"
                 alt="<?= $escaper->escapeHtmlAttr(__('Apply')) ?>" class="v-middle"
                 title="<?= $escaper->escapeHtmlAttr(__('Apply')) ?>"/>
        </a>
    </span>
</span>
<div id="<?= $escaper->escapeHtmlAttr($containerId) ?>" class="rule-chooser"></div>
